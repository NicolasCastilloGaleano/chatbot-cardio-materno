# Copiar a .env y completar. NUNCA versionar .env.
# Regla general: una variable vacía toma su valor por defecto (indicado en cada comentario).
# Referencia completa: docs/08-despliegue/instalacion.md, sección "Variables".

# =============================================================================
# 1. General
# =============================================================================
# Entorno: development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Canal activo: console | telegram | whatsapp
CHANNEL=console

# =============================================================================
# 2. Servidor de Ollama (ADR 0005)
# =============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Tiempo que Ollama mantiene los modelos cargados entre turnos (defecto: 30m)
OLLAMA_KEEP_ALIVE=30m

# =============================================================================
# 3. Modelos y generación (ADR 0008 y ADR 0011)
# Valores generales: los usa cada etapa si no define el suyo.
# =============================================================================
# Modelo general (nombre exacto de `ollama list`; defecto: mistral-small3.1:24b)
OLLAMA_MODEL=mistral-small3.1:24b
# Creatividad, de 0 (predecible) a 1 (defecto: 0.3)
OLLAMA_TEMPERATURE=0.3
# Ventana de contexto en tokens (defecto: 4096)
OLLAMA_NUM_CTX=4096
# Espera máxima por respuesta en segundos (defecto: 180)
OLLAMA_TIMEOUT_SECONDS=180
# Razonamiento de modelos como qwen3: true | false (vacío = no se envía)
OLLAMA_THINK=

# --- Etapa de análisis (hilo, síntomas, códigos de signos, alcance; nunca ve evidencia) ---
# Decisión del equipo (2026-10-12, ADR 0011): mistral-small3.1:24b
OLLAMA_ANALYSIS_MODEL=mistral-small3.1:24b
OLLAMA_ANALYSIS_TEMPERATURE=
OLLAMA_ANALYSIS_NUM_CTX=
OLLAMA_ANALYSIS_TIMEOUT_SECONDS=
OLLAMA_ANALYSIS_THINK=
# Máximo de tokens que genera (defecto: 600; auto = sin límite)
OLLAMA_ANALYSIS_NUM_PREDICT=

# --- Etapa de respuesta (redacta frase por frase con la evidencia) ---
# Decisión del equipo (2026-10-12, ADR 0011): qwen3:8b sin razonamiento
OLLAMA_REPLY_MODEL=qwen3:8b
OLLAMA_REPLY_TEMPERATURE=
OLLAMA_REPLY_NUM_CTX=
OLLAMA_REPLY_TIMEOUT_SECONDS=
OLLAMA_REPLY_THINK=false
# Máximo de tokens que genera (defecto: 500; auto = sin límite)
OLLAMA_REPLY_NUM_PREDICT=

# =============================================================================
# 4. RAG: base de conocimiento y búsqueda de evidencia (HU-02, ADR 0008)
# =============================================================================
RAG_ENABLED=true
# Modelo de embeddings: debe coincidir con el del índice (run_build_kb_index.py)
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_EMBED_TIMEOUT_SECONDS=120
# Capas del embedder en GPU: 0 = CPU, deja la GPU al LLM (defecto); auto = decide Ollama
OLLAMA_EMBED_NUM_GPU=0
# Textos por lote al construir el índice (defecto: 16)
EMBED_BATCH_SIZE=16
KB_ENTRIES_FILE=knowledge/kb/entries.jsonl
KB_INDEX_DIR=data/kb_index
# Cuadros de la base v2 (ADR 0017). Solo se leen si la base tiene cuadros; con la v1 se ignora.
# Para probar la v2 sin reemplazar la v1 (MIG-07):
#   python scripts/convert_rag_xlsx.py RAG_2.xlsx data/kb_v2
#   KB_ENTRIES_FILE=data/kb_v2/entries.jsonl
#   KB_CASES_FILE=data/kb_v2/cuadros.jsonl
#   KB_INDEX_DIR=data/kb_index_v2
#   y luego: python run_build_kb_index.py
# Para volver a la v1, comenta esas tres líneas (el índice de la v1 no se toca).
KB_CASES_FILE=knowledge/kb/cuadros.jsonl
# Valores calibrados por defecto (umbral, top-k, instrucción de consulta)
EVIDENCE_POLICY_FILE=knowledge/evidence_policy.json

# Umbrales de búsqueda. Vacío = el valor de EVIDENCE_POLICY_FILE; si tienen valor, mandan.
# Similitud mínima para que un registro cuente como evidencia, de 0 a 1 (archivo: 0.50)
RAG_MIN_SIMILARITY=0.50
# Registros que se entregan al agente (archivo: 3)
RAG_TOP_K=
# Candidatos por búsqueda antes de fusionar (archivo: 12)
RAG_CANDIDATE_K=
# Registros por turno con la base v2, del cuadro identificado (ADR 0018; defecto: 1)
RAG_CASE_TOP_K=

# =============================================================================
# 5. Verificación del respaldo de cada frase (ADR 0010)
# Vacío = el valor de EVIDENCE_POLICY_FILE.
# =============================================================================
# Fracción mínima de palabras de una frase que deben estar en el registro citado (archivo: 0.6)
GROUNDING_MIN_SUPPORT=
# Frases sin cita permitidas, p. ej., una pregunta de aclaración (archivo: 2)
GROUNDING_MAX_FREE_SENTENCES=
# Palabras máximas de una frase sin cita (archivo: 20)
GROUNDING_MAX_FREE_WORDS=

# =============================================================================
# 6. Alarmas (HU-03/HU-04, ADR 0007 y ADR 0012). PROVISIONAL: no validado clínicamente.
# =============================================================================
ALARM_RULES_FILE=knowledge/alarm_rules.json

# =============================================================================
# 7. Hilos y consola (HU-06, ADR 0006)
# =============================================================================
# Mensajes recientes del hilo que se envían al agente como contexto (defecto: 6)
THREAD_CONTEXT_MESSAGES=6
# Muestra las líneas de depuración [hilo …], [evidencia …], [tiempos …]
SHOW_THREAD_DEBUG=true
# Carpeta de los hilos JSON anteriores; solo la usa run_import_history.py (ADR 0016)
THREADS_DIR=data/threads

# =============================================================================
# 8. Interfaz web local de demostración y auditoría (ADR 0013): python run_web.py
# Solo se admite la propia máquina: 127.0.0.1, localhost o ::1 (defecto: 127.0.0.1)
# =============================================================================
WEB_HOST=127.0.0.1
# Puerto (defecto: 8000)
WEB_PORT=8000
# Mensajes por página al abrir un chat o subir con el scroll (1 a 200; defecto: 30)
WEB_PAGE_SIZE=30
# Segundos entre consultas de mensajes nuevos (defecto: 3)
WEB_POLL_SECONDS=3

# =============================================================================
# 9. Canal WhatsApp (HU-09, ADR 0014): python run_whatsapp.py + ngrok
# Guía de Meta y ngrok: docs/08-despliegue/instalacion.md, sección "Canal WhatsApp"
# =============================================================================
# Obligatorias (sin ellas el canal no arranca). Son secretos: solo en .env.
# Token de acceso (temporal de 24 h en "API Setup", o permanente de un usuario del sistema)
WHATSAPP_TOKEN=
# "Phone number ID" del número de prueba (no es el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=
# Cadena larga y aleatoria inventada por el equipo; la misma se escribe en Meta (Webhook)
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App Secret: verifica la firma de cada notificación
WHATSAPP_APP_SECRET=
# Secreto del HMAC que seudonimiza los números (ADR 0015). Si se pierde, las personas
# quedan desligadas de su historial: respaldarlo junto con la base
USER_ID_HASH_SECRET=
# Versión de la Graph API (defecto: v23.0; usar la que muestra el panel de Meta)
WHATSAPP_API_VERSION=v23.0
# Solo loopback (127.0.0.1, localhost o ::1); ngrok publica la URL (defecto: 127.0.0.1)
WHATSAPP_HOST=127.0.0.1
# Puerto del webhook (defecto: 8001)
WHATSAPP_PORT=8001
# Tiempo máximo de cada envío a Meta, en segundos (defecto: 15)
WHATSAPP_SEND_TIMEOUT_SECONDS=15
# Segundos antes del aviso "Estoy revisando tu mensaje" (defecto: 10)
WHATSAPP_WAIT_NOTICE_SECONDS=10
# Mensajes en cola antes de pedir a Meta que reintente (defecto: 100)
WHATSAPP_MAX_PENDING=100

# =============================================================================
# 10. Persistencia por usuario (ADR 0015)
# =============================================================================
# Base SQLite de usuarios, chats, hilos y mensajes de TODOS los canales: consola, web y
# WhatsApp (defecto: data/cardio_materno.db)
DATABASE_PATH=data/cardio_materno.db
# Horas sin actividad tras las cuales se cierra el hilo abierto de una persona (defecto: 12)
THREAD_IDLE_TIMEOUT_HOURS=12

# =============================================================================
# 11. Canales de fases siguientes
# =============================================================================
TELEGRAM_BOT_TOKEN=