# Copiar a .env y completar. NUNCA versionar .env.

# Entorno: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Canal activo: console | telegram | whatsapp
CHANNEL=console

# LLM (proveedor por definir en un ADR)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Telegram (fase 2)
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (fase 3)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Persistencia
DATABASE_URL=
