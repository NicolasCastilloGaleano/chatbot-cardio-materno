# Copiar a .env y completar. NUNCA versionar .env.

# Entorno: development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# Canal activo: console | telegram | whatsapp
CHANNEL=console

# LLM: Ollama local (ADR 0005). Vacío = valor por defecto.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Nombre exacto de `ollama list`
OLLAMA_MODEL=mistral-small3.1:24b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096

# Hilos conversacionales (HU-06, ADR 0006)
# Mensajes recientes del hilo actual que se envían al agente como contexto
THREAD_CONTEXT_MESSAGES=6
# Muestra en consola la línea [hilo … | dominio | estado | nuevo/continúa]
SHOW_THREAD_DEBUG=true
# Carpeta de los JSON de los hilos (relativa a la raíz del proyecto)
THREADS_DIR=data/threads

# Catálogo de reglas de alarma (HU-03/HU-04, ADR 0007). PROVISIONAL: no validado clínicamente.
ALARM_RULES_FILE=knowledge/alarm_rules.json

# Modelos por etapa (ADR 0008). Vacío = OLLAMA_MODEL.
OLLAMA_ANALYSIS_MODEL=
OLLAMA_REPLY_MODEL=

# Latencia (ver docs/08-despliegue/operacion.md y ADR 0011)
# Tiempo que Ollama mantiene los modelos cargados entre turnos
OLLAMA_KEEP_ALIVE=30m
# Capas del embedder en GPU: 0 = CPU (por defecto, deja la GPU al LLM); auto = decide Ollama
OLLAMA_EMBED_NUM_GPU=0
# Máximo de tokens por etapa (vacío = 600 y 500; auto = sin límite)
OLLAMA_ANALYSIS_NUM_PREDICT=
OLLAMA_REPLY_NUM_PREDICT=
# Razonamiento de modelos como qwen3: false para desactivarlo; vacío = no se envía
OLLAMA_THINK=

# RAG: base de conocimiento y evidencia (HU-02, ADR 0008)
RAG_ENABLED=true
# Debe coincidir con el modelo con el que se construyó el índice (run_build_kb_index.py)
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_EMBED_TIMEOUT_SECONDS=120
EMBED_BATCH_SIZE=16
KB_ENTRIES_FILE=knowledge/kb/entries.jsonl
KB_INDEX_DIR=data/kb_index
EVIDENCE_POLICY_FILE=knowledge/evidence_policy.json

# Telegram (fase 2)
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (fase 3)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Persistencia
DATABASE_URL=
